{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ATS",
  "version": "0.1.0",
  "identifier": "dev.tunee.ats",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ATS 설정",
        "width": 520,
        "height": 680,
        "resizable": true
      },
      {
        "label": "preview",
        "title": "ATS 미리보기",
        "url": "preview.html",
        "width": 420,
        "height": 64,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
